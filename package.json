{
  "name": "@localnerve/authorizer-js",
  "version": "1.0.7",
  "author": "Lakhan Samani",
  "license": "MIT",
  "funding": "https://github.com/sponsors/authorizerdev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localnerve/authorizer-js.git"
  },
  "bugs": {
    "url": "https://github.com/localnerve/authorizer-js/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.mjs"
    }
  },
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "unpkg": "lib/authorizer.min.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "size-limit": [
    {
      "path": "lib/authorizer.min.js",
      "limit": "4 kB"
    }
  ],
  "scripts": {
    "ts-types": "tsc --emitDeclarationOnly --outDir lib --project tsconfig.build.json",
    "build": "tsup && npm run ts-types",
    "test": "npm run build && node --experimental-strip-types --test __test__/index.test.mts",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit",
    "size": "size-limit"
  },
  "browser": {
    "path": "path-browserify"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.6",
    "size-limit": "^14.3.0",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.8",
    "glob": "^14.0.6"
  }
}
